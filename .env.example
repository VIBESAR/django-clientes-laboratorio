# Renombra a .env en tu PC y edita tus valores; NO subas .env a GitHub.
DJANGO_SECRET_KEY=CAMBIAR_POR_CLAVE_LARGA_GENERADA_ALEATORIAMENTE
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# MySQL local (laboratorio)
DB_ENGINE=mysql
DB_NAME=django_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Si deseas envío real de enlaces de recuperación, configura SMTP:
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USER=usuario
# SMTP_PASSWORD=clave-de-aplicacion
# SMTP_FROM=noreply@tu-dominio.com
